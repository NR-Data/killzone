    "sharedRules": [
      {
        "name": "Hit and Run",
        "id": "f183-3eda-2b2b-6afe",
        "description": "Rebels have sole access to the order 'Hit and Run', which operates as follows:\n \nCan move up to 10\".\n \nCan take 1 shot.\n \nNo figure in the group may be suppressed at the time the order is given.\n \nA rebel leader must be in the squad to issue this order.\n \nAll figures in the group must be in headset contact.",
        "hidden": false
      }
